EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Social sign-in buttons on the auth screen only render when the matching flag
# below is "true". Turn one on only after you've enabled that provider in the
# Supabase dashboard (Authentication -> Providers) and added the app's redirect
# URL (drawingbattle://auth/callback) to its allow list:
#   Google: https://supabase.com/docs/guides/auth/social-login/auth-google
#   Apple:  https://supabase.com/docs/guides/auth/social-login/auth-apple
EXPO_PUBLIC_ENABLE_GOOGLE_AUTH=false
EXPO_PUBLIC_ENABLE_APPLE_AUTH=false
